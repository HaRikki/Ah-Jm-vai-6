generator client {
  provider = "prisma-client-js"
  # output default node_modules/.prisma
}

datasource db {
  // Production: change to "postgresql"
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  email         String    @unique
  password      String?
  name          String?
  image         String?
  balance       Decimal   @default(0) @db.Decimal(18, 6)
  role          String    @default("user")
  status        String    @default("active")
  apiKey        String?   @unique
  apiEnabled    Boolean   @default(false)
  apiRateLimit  Int       @default(60)
  emailVerified DateTime?
  resetToken    String?
  resetExpires  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  transactions  Transaction[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  couponsUsed   CouponUsage[]

  @@index([email])
  @@index([username])
  @@index([apiKey])
  @@index([status])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  nameKm      String?
  slug        String    @unique
  platform    String
  icon        String?
  sortOrder   Int       @default(0)
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]
  @@index([platform])
  @@index([status])
}

model Service {
  id                String   @id @default(cuid())
  name              String
  nameKm            String?
  description       String?
  descriptionKm     String?
  categoryId        String
  providerId        String?
  providerServiceId String?
  min               Int      @default(1)
  max               Int      @default(10000)
  price             Decimal  @default(0) @db.Decimal(18, 6)
  cost              Decimal  @default(0) @db.Decimal(18, 6)
  status            String   @default("active")
  refill            Boolean  @default(false)
  cancel            Boolean  @default(false)
  averageTime       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  category          Category @relation(fields: [categoryId], references: [id])
  provider          Provider? @relation(fields: [providerId], references: [id])
  orders            Order[]
  mappings          ServiceMapping[]
  @@index([categoryId])
  @@index([status])
  @@index([providerId])
}

model Provider {
  id          String   @id @default(cuid())
  name        String
  apiUrl      String
  apiKey      String
  balance     Decimal  @default(0) @db.Decimal(18, 6)
  currency    String   @default("USD")
  status      String   @default("active")
  userEnabled Boolean  @default(true)
  priority    Int      @default(0)
  lastSync    DateTime?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  services    Service[]
  mappings    ServiceMapping[]
  orders      Order[]
  @@index([status])
  @@index([userEnabled])
  @@index([priority])
}

model ServiceMapping {
  id                String   @id @default(cuid())
  serviceId         String
  providerId        String
  providerServiceId String
  providerCost      Decimal  @default(0) @db.Decimal(18, 6)
  sellingPrice      Decimal  @default(0) @db.Decimal(18, 6)
  min               Int
  max               Int
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  service           Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  provider          Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  @@unique([serviceId, providerId])
}

model Order {
  id               String   @id @default(cuid())
  userId           String
  serviceId        String
  providerId       String?
  providerOrderId  String?
  link             String
  quantity         Int
  price            Decimal  @default(0) @db.Decimal(18, 6)
  cost             Decimal  @default(0) @db.Decimal(18, 6)
  profit           Decimal  @default(0) @db.Decimal(18, 6)
  status           String   @default("pending")
  startCount       Int?
  remains          Int?
  notes            String?
  idempotencyKey   String?  @unique
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])
  service          Service  @relation(fields: [serviceId], references: [id])
  provider         Provider? @relation(fields: [providerId], references: [id])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([providerOrderId])
}

model Transaction {
  id                  String   @id @default(cuid())
  userId              String
  amount              Decimal  @default(0) @db.Decimal(18, 6)
  balanceBefore       Decimal? @db.Decimal(18, 6)
  balanceAfter        Decimal? @db.Decimal(18, 6)
  paymentMethod       String
  providerTxnId       String?
  status              String   @default("pending")
  type                String   @default("deposit")
  description         String?
  adminId             String?
  metadata            String?
  expiresAt           DateTime?
  paidAt              DateTime?
  creditedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([status])
  @@index([paymentMethod])
  @@index([providerTxnId])
  @@index([type])
  @@unique([providerTxnId, paymentMethod])
}

model PaymentMethod {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  enabled     Boolean  @default(false)
  minAmount   Decimal  @default(1) @db.Decimal(18, 6)
  maxAmount   Decimal  @default(10000) @db.Decimal(18, 6)
  config      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  type          String
  value         Decimal  @default(0) @db.Decimal(18, 6)
  minAmount     Decimal  @default(0) @db.Decimal(18, 6)
  maxUses       Int?
  usedCount     Int      @default(0)
  startDate     DateTime?
  endDate       DateTime?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  usages        CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  usedAt    DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  @@unique([couponId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  titleKm   String?
  message   String
  messageKm String?
  type      String   @default("info")
  read      Boolean  @default(false)
  broadcast Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiRequestLog {
  id        String   @id @default(cuid())
  apiKey    String
  userId    String?
  endpoint  String
  ip        String?
  createdAt DateTime @default(now())
  @@index([apiKey, createdAt])
  @@index([userId])
}


model ServiceImport {
  id            String   @id @default(cuid())
  adminId       String
  providerId    String
  pricingMode   String
  profitValue   Decimal  @default(0) @db.Decimal(18, 6)
  fetched       Int      @default(0)
  selected      Int      @default(0)
  added         Int      @default(0)
  updated       Int      @default(0)
  skipped       Int      @default(0)
  failed        Int      @default(0)
  status        String   @default("completed")
  details       String?
  createdAt     DateTime @default(now())
  @@index([providerId])
  @@index([createdAt])
  @@index([adminId])
}
